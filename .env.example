JIRA_ENHANCER_CONNECTOR_MODE=mock
JIRA_ENHANCER_RL_ENABLED=false
JIRA_ENHANCER_RL_PROMPT_LIBRARY_PATH=
JIRA_ENHANCER_RL_POLICY=thompson
JIRA_ENHANCER_RL_TARGET_CONFIDENCE=10
JIRA_ENHANCER_RL_MAX_PROMPT_RETRIES=10

# Live Jira
JIRA_BASE_URL=https://jira.example.com
JIRA_USERNAME=user@example.com
JIRA_TOKEN=replace-me
JIRA_ACCEPTANCE_CRITERIA_FIELD=customfield_12345
JIRA_DEPENDENCIES_FIELD=customfield_12346
JIRA_EDGE_CASES_FIELD=customfield_12347
JIRA_FEATURE_FIELD=customfield_12348
JIRA_FEATURE_JQL_FIELD=cf[12348]
JIRA_RELEASE_FIELD=fixVersions
JIRA_RELEASE_JQL_FIELD=fixVersion
JIRA_SPRINT_FIELD=customfield_12349
JIRA_AI_SUMMARY_FIELD_ID=customfield_12350
JIRA_AI_BRIEF_FIELD_ID=customfield_12351

# Live Confluence
CONFLUENCE_BASE_URL=https://confluence.example.com
CONFLUENCE_USERNAME=user@example.com
CONFLUENCE_TOKEN=replace-me

# Live Bitbucket
BITBUCKET_BASE_URL=https://bitbucket.example.com
BITBUCKET_USERNAME=user@example.com
BITBUCKET_TOKEN=replace-me
